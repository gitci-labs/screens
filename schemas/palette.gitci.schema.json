{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screens.gitci.com/schemas/palette.gitci.schema.json",
  "title": "GitCI Screens Palette",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "colors"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "colors": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": {
        "light": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "dark": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    }
  }
}
